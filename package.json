{
  "name": "launcher",
  "productName": "CLRE-Launcher",
  "version": "2026.11.1",
  "description": "Lanceur de jeux qui synchronise ta bibliothèque Steam",
  "main": "src/main.js",
  "license": "MIT",
  "scripts": {
    "postinstall": "install-electron --no",
    "start": "electron .",
    "test": "node --test test/",
    "doctor": "node scripts/mac-doctor.js",
    "dist": "electron-builder --win portable",
    "dist:mac": "electron-builder --mac dmg zip",
    "icons": "electron scripts/build-icons.js"
  },
  "build": {
    "appId": "local.clre-launcher",
    "productName": "CLRE-Launcher",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "!src/dev-snap.js",
      "assets/*.png",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "assets/icon.ico",
      "signAndEditExecutable": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.games",
      "icon": "assets/icon-512.png"
    },
    "portable": {
      "artifactName": "CLRE-Launcher.exe"
    },
    "asarUnpack": [
      "**/saves-worker.js",
      "**/node_modules/js-yaml/**",
      "**/node_modules/argparse/**"
    ]
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "hls.js": "^1.7.4",
    "js-yaml": "^4.3.2"
  }
}
